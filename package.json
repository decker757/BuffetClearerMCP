{
  "name": "buffet-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "scripts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/shared packages/mcp-server packages/widget scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:widget": "npm run dev -w @buffet/widget",
    "dev:mcp": "npm run dev -w @buffet/mcp-server",
    "spike:xrpl": "tsx scripts/xrpl-spike.ts",
    "fund:treasury": "tsx scripts/fund-treasury.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
