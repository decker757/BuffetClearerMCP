{
  "name": "aishop4u-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "scripts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/shared packages/payments packages/mcp-server packages/shops scripts && tsc -p packages/widget",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:widget": "npm run dev -w @aishop4u/widget",
    "dev:mcp": "npm run dev -w @aishop4u/mcp-server",
    "spike:xrpl": "tsx scripts/xrpl-spike.ts",
    "fund:treasury": "tsx scripts/fund-treasury.ts",
    "provision": "tsx scripts/provision.ts",
    "dev:shops": "npm run dev -w @aishop4u/shops",
    "x402:buy": "tsx scripts/x402-buy.ts",
    "settle:demo": "tsx scripts/settle-demo.ts",
    "sweep:shops": "tsx scripts/sweep-shops.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
