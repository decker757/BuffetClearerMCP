# Copy to .env. Testnet only. Never commit .env.

# XRPL
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_NETWORK=xrpl:1
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
RLUSD_CURRENCY_HEX=524C555344000000000000000000000000000000

# Treasury wallet (funded from the XRP faucet + tryrlusd.com). Seed stays here only.
TREASURY_SEED=

# x402
X402_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai

# Servers
MCP_PORT=3001
SHOPS_PORT=4002

# Fee, in RLUSD, flat per session (CLAUDE.md §11)
SERVICE_FEE=0.25

# Stripe (optional). Without a key, the card leg is mocked. TEST MODE ONLY — the code
# refuses a non-sk_test_ key. Get it at dashboard.stripe.com → Developers → API keys.
# Charges server-side with a Stripe test card; no publishable key, webhook, or frontend needed.
STRIPE_SECRET_KEY=

# Invoice email delivery (optional). Without a key, invoices are written to .outbox/ only.
# Get a key at resend.com. INVOICE_FROM needs a Resend-verified domain to send from your
# own address; otherwise use onboarding@resend.dev, which only delivers to the email of
# the Resend account that owns the key (so enter that same address as billing in the widget).
RESEND_API_KEY=
INVOICE_FROM=onboarding@resend.dev

# Recipient for the demo/driver scripts (scripts/mcp-smoke.ts, settle-demo.ts, x402-buy.ts).
# With onboarding@resend.dev this must be your own Resend account email to actually deliver.
# In the Claude Desktop demo you type the billing email into the widget instead.
DEMO_BILLING_EMAIL=
